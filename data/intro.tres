world_lines = Array[String](["This world is widely inhabited by creatures known as POKEMON!", "We humans live alongside POKEMON as friends.", "At times we play together, and at other times we work together."])
ask_character_lines = Array[String](["Now then...", "First things first. Tell me a little about yourself."])
ask_name_lines = Array[String](["So tell me...\\nWhat is your name?"])
confirm_name_lines = Array[String](["Right, so your name is {PLAYER}!"])
ask_rival_lines = Array[String](["This is my grandson.", "He's been your rival since you both were babies.", "...Erm, what was his name again?"])
confirm_rival_lines = Array[String](["That's right! I remember now! His name is {RIVAL}!"])
farewell_lines = Array[String](["{PLAYER}!", "Your very own POKEMON legend is about to unfold!", "A world of dreams and adventures with POKEMON awaits!\\nLet's go!"])
