intro = Array[String](["Hello. This is \\TN.", "Good day, \\PN! Hi. This is \\TN.", "How are you doing? \\PN, howdy! This is \\TN. Isn't it nice out?", "\\PN, good day! It's me, \\TN. Got a minute?", "Hello, \\PN. This is \\TN. How are things?"])
