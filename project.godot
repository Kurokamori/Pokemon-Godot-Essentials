; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pokemon Godot Essentials"
run/main_scene="uid://b8ok3srhauf22"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameSettings="*uid://dcu3cm0tnnhyd"
Database="*uid://cjgw44nx1g16o"
RNG="*uid://bjtxlmkcxq0nn"
AudioManager="*uid://bqt3octbiuvjf"
GameState="*uid://bt35egkv3xog6"
UITheme="*uid://b5vaheq0p4tr0"
SaveManager="*uid://b7sw8kcr0g1m6"
SceneRouter="*uid://ccprht66gxam5"
Localization="*uid://r3ykbq6fnjky"

[debug]

gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=512
window/size/viewport_height=384
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://addons/": "purple",
"res://assets/": "green",
"res://data/": "yellow",
"res://docs/": "gray",
"res://game/": "orange",
"res://locale/": "teal",
"res://scenes/": "blue",
"res://shaders/": "pink",
"res://src/": "red",
"res://src/core/": "red",
"res://tools/": "gray"
}

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
